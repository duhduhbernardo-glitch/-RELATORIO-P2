<script>

(function(){

  // Ciclo padrão original

  const cicloHIITPadrao = [

    { zona: 'z1', duracao: 20, fala: "Z1 Aquecimento ativado. Cadencia forte para preparar." },

    { zona: 'z2', duracao: 20, fala: "Z2 Ritmo ativo. Mantenha movimento constante." },

    { zona: 'z3', duracao: 20, fala: "Z3 Limiar alto! Acelere os pes agora!" },

    { zona: 'z4', duracao: 20, fala: "Z4 SPRINT MAXIMO! Forca total por 20 segundos!" }

  ];

  // Ciclo atual (começa com o padrão)

  let cicloHIIT = JSON.parse(JSON.stringify(cicloHIITPadrao));

  // Sequências salvas no localStorage

  let sequenciasSalvas = {};

  const zonas = {

    z1: { nome: "Z1 Aquecimento", xPos: -3.0, vel: 22.0, rpm: 75, cor: "#2196F3", hex: 0x2196F3 },

    z2: { nome: "Z2 Ritmo Ativo", xPos: -1.0, vel: 30.0, rpm: 95, cor: "#4CAF50", hex: 0x4CAF50 },

    z3: { nome: "Z3 HIIT Intenso", xPos:  1.0, vel: 40.0, rpm: 115, cor: "#FF9800", hex: 0xFF9800 },

    z4: { nome: "Z4 SPRINT TOTAL", xPos:  3.0, vel: 52.0, rpm: 140, cor: "#F44336", hex: 0xF44336 }

  };

  // Frases do treinador para cada zona (usadas em sequências personalizadas)

  const frasesTreinador = {

    z1: "Z1 Aquecimento. Cadencia leve para preparar o corpo.",

    z2: "Z2 Ritmo ativo. Mantenha movimento constante e respirando bem.",

    z3: "Z3 Intenso! Acelere os pes, aumente a cadencia!",

    z4: "Z4 SPRINT MAXIMO! Forca total! De tudo de si!"

  };

  function falarTreinador(texto) {

    document.getElementById('falaTreinador').textContent = texto;

    if ('speechSynthesis' in window) {

      window.speechSynthesis.cancel();

      const fala = new SpeechSynthesisUtterance(texto);

      fala.lang = 'pt-BR';

      fala.rate = 1.15;

      const vozes = window.speechSynthesis.getVoices();

      const vozMasculina = vozes.find(v => v.lang.includes('pt') && (v.name.toLowerCase().includes('daniel') || v.name.toLowerCase().includes('google portugues do brasil') && !v.name.toLowerCase().includes('female') || v.name.toLowerCase().includes('male') || v.name.toLowerCase().includes('antonio') || v.name.toLowerCase().includes('manoel')));

      if (vozMasculina) fala.voice = vozMasculina;

      else {

        const vozPt = vozes.find(v => v.lang.includes('pt'));

        if (vozPt) fala.voice = vozPt;

      }

      window.speechSynthesis.speak(fala);

    }

  }

  if ('speechSynthesis' in window) {

    window.speechSynthesis.onvoiceschanged = () => window.speechSynthesis.getVoices();

  }

  // ============ CARREGAR SEQUÊNCIAS SALVAS ============

  function carregarSequenciasSalvas() {

    const salvas = localStorage.getItem('sequenciasTreino');

    if (salvas) {

      sequenciasSalvas = JSON.parse(salvas);

    }

    atualizarSeletorSequencias();

    atualizarListaSequenciasSalvas();

  }

  function salvarSequenciasNoStorage() {

    localStorage.setItem('sequenciasTreino', JSON.stringify(sequenciasSalvas));

  }

  function atualizarSeletorSequencias() {

    const seletor = document.getElementById('seletorSequencia');

    seletor.innerHTML = '<option value="padrao">Padrão HIIT (Z1→Z2→Z3→Z4) - 20s cada</option>';

    Object.keys(sequenciasSalvas).forEach(nome => {

      const seq = sequenciasSalvas[nome];

      const totalSegundos = seq.reduce((s, e) => s + e.duracao, 0);

      seletor.innerHTML += `<option value="${nome}">${nome} (${seq.length} etapas • ${totalSegundos}s/ciclo)</option>`;

    });

  }

  function atualizarInfoSequenciaAtual() {

    const info = document.getElementById('sequenciaAtualInfo');

    const totalSegundos = cicloHIIT.reduce((s, e) => s + e.duracao, 0);

    info.textContent = `${cicloHIIT.length} etapa${cicloHIIT.length > 1 ? 's' : ''} • ${totalSegundos}s por ciclo`;

  }

  // ============ MODAL DE SEQUÊNCIAS ============

  const modal = document.getElementById('modalSequencias');

  const btnSequencia = document.getElementById('btnSequencia');

  const btnFecharModal = document.getElementById('btnFecharModal');

  const btnAdicionarEtapa = document.getElementById('btnAdicionarEtapa');

  const btnSalvarSequencia = document.getElementById('btnSalvarSequencia');

  const btnLimparSequencia = document.getElementById('btnLimparSequencia');

  const listaEtapas = document.getElementById('listaEtapas');

  const listaSequenciasSalvas = document.getElementById('listaSequenciasSalvas');

  const nomeSequenciaInput = document.getElementById('nomeSequencia');

  btnSequencia.addEventListener('click', () => {

    modal.classList.add('aberto');

    carregarEtapasNoModal();

  });

  btnFecharModal.addEventListener('click', () => {

    modal.classList.remove('aberto');

  });

  modal.addEventListener('click', (e) => {

    if (e.target === modal) modal.classList.remove('aberto');

  });

  function carregarEtapasNoModal() {

    listaEtapas.innerHTML = '';

    // Carrega o ciclo atual no modal para edição

    cicloHIIT.forEach(etapa => {

      adicionarItemEtapa(etapa.zona, etapa.duracao);

    });

    atualizarListaSequenciasSalvas();

  }

  function adicionarItemEtapa(zona = 'z1', duracao = 20) {

    const div = document.createElement('div');

    div.className = 'etapa-item';

    div.innerHTML = `

      <select class="zona-z${zona === 'z1' ? '1' : zona === 'z2' ? '2' : zona === 'z3' ? '3' : '4'}">

        <option value="z1" ${zona === 'z1' ? 'selected' : ''}>Z1 - Aquecimento (22 km/h)</option>

        <option value="z2" ${zona === 'z2' ? 'selected' : ''}>Z2 - Ritmo Ativo (30 km/h)</option>

        <option value="z3" ${zona === 'z3' ? 'selected' : ''}>Z3 - HIIT Intenso (40 km/h)</option>

        <option value="z4" ${zona === 'z4' ? 'selected' : ''}>Z4 - Sprint Total (52 km/h)</option>

      </select>

      <input type="number" value="${duracao}" min="5" max="300" placeholder="Segundos">

      <span style="font-size:0.6rem;color:#888;font-family:monospace;">seg</span>

      <button class="btn-remover">×</button>

    `;

    // Atualizar cor ao mudar a zona

    const select = div.querySelector('select');

    select.addEventListener('change', () => {

      select.className = 'zona-' + select.value;

    });

    // Remover etapa

    div.querySelector('.btn-remover').addEventListener('click', () => {

      div.remove();

    });

    listaEtapas.appendChild(div);

  }

  btnAdicionarEtapa.addEventListener('click', () => {

    adicionarItemEtapa('z1', 20);

  });

  btnLimparSequencia.addEventListener('click', () => {

    listaEtapas.innerHTML = '';

    nomeSequenciaInput.value = '';

  });

  btnSalvarSequencia.addEventListener('click', () => {

    const nome = nomeSequenciaInput.value.trim();

    if (!nome) {

      alert('Digite um nome para a sequência!');

      return;

    }

    const etapas = [];

    const itens = listaEtapas.querySelectorAll('.etapa-item');

    itens.forEach(item => {

      const zona = item.querySelector('select').value;

      const duracao = parseInt(item.querySelector('input').value) || 20;

      etapas.push({

        zona: zona,

        duracao: duracao,

        fala: frasesTreinador[zona]

      });

    });

    if (etapas.length === 0) {

      alert('Adicione pelo menos uma etapa!');

      return;

    }

    sequenciasSalvas[nome] = etapas;

    salvarSequenciasNoStorage();

    atualizarSeletorSequencias();

    atualizarListaSequenciasSalvas();

    alert('Sequência "' + nome + '" salva com sucesso!');

  });

  function atualizarListaSequenciasSalvas() {

    listaSequenciasSalvas.innerHTML = '';

    if (Object.keys(sequenciasSalvas).length === 0) {

      listaSequenciasSalvas.innerHTML = '<div style="font-size:0.7rem;color:#666;text-align:center;padding:12px;">Nenhuma sequência salva ainda.</div>';

      return;

    }

    Object.keys(sequenciasSalvas).forEach(nome => {

      const seq = sequenciasSalvas[nome];

      const totalSegundos = seq.reduce((s, e) => s + e.duracao, 0);

      const div = document.createElement('div');

      div.className = 'sequencia-salva-item';

      div.innerHTML = `

        <div>

          <div class="sequencia-nome">${nome}</div>

          <div class="sequencia-info">${seq.length} etapa${seq.length > 1 ? 's' : ''} • ${totalSegundos}s • ${seq.map(e => e.zona.toUpperCase()).join(' → ')}</div>

        </div>

        <div class="sequencia-acoes">

          <button class="btn-seq usar" data-nome="${nome}">USAR</button>

          <button class="btn-seq excluir" data-nome="${nome}">EXCLUIR</button>

        </div>

      `;

      div.querySelector('.btn-seq.usar').addEventListener('click', () => {

        cicloHIIT = JSON.parse(JSON.stringify(sequenciasSalvas[nome]));

        document.getElementById('seletorSequencia').value = nome;

        atualizarInfoSequenciaAtual();

        alert('Sequência "' + nome + '" selecionada!');

        modal.classList.remove('aberto');

      });

      div.querySelector('.btn-seq.excluir').addEventListener('click', () => {

        if (confirm('Excluir a sequência "' + nome + '"?')) {

          delete sequenciasSalvas[nome];

          salvarSequenciasNoStorage();

          atualizarSeletorSequencias();

          atualizarListaSequenciasSalvas();

        }

      });

      listaSequenciasSalvas.appendChild(div);

    });

  }

  // Seletor de sequência

  document.getElementById('seletorSequencia').addEventListener('change', (e) => {

    if (e.target.value === 'padrao') {

      cicloHIIT = JSON.parse(JSON.stringify(cicloHIITPadrao));

    } else if (sequenciasSalvas[e.target.value]) {

      cicloHIIT = JSON.parse(JSON.stringify(sequenciasSalvas[e.target.value]));

    }

    atualizarInfoSequenciaAtual();

  });

  // ============ CÓDIGO ORIGINAL DO TREINO ============

  const container = document.getElementById('canvas-container');

  const scene = new THREE.Scene();

  scene.fog = new THREE.FogExp2(0x050508, 0.035);

  const camera = new THREE.PerspectiveCamera(70, container.clientWidth / container.clientHeight, 0.1, 1000);

  camera.position.set(zonas.z1.xPos, 1.25, 0);

  const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });

  renderer.setSize(container.clientWidth, container.clientHeight);

  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

  container.appendChild(renderer.domElement);

  const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);

  scene.add(ambientLight);

  const headlight = new THREE.SpotLight(0xffffff, 3.5, 50, Math.PI / 3, 0.4);

  headlight.position.set(0, 1.2, -0.1);

  headlight.target.position.set(0, 0, -25);

  scene.add(headlight); scene.add(headlight.target);

  const povGroup = new THREE.Group();

  scene.add(povGroup);

  povGroup.position.x = zonas.z1.xPos;

  const matHandle = new THREE.MeshStandardMaterial({ color: 0x111115, roughness: 0.4, metalness: 0.8 });

  const matGrip = new THREE.MeshStandardMaterial({ color: 0x222225, roughness: 0.9 });

  const stem = new THREE.Mesh(new THREE.CylinderGeometry(0.025, 0.025, 0.3), matHandle);

  stem.rotation.x = Math.PI / 3; stem.position.set(0, 0.85, -0.4); povGroup.add(stem);

  const bar = new THREE.Mesh(new THREE.CylinderGeometry(0.02, 0.02, 0.75), matHandle);

  bar.rotation.z = Math.PI / 2; bar.position.set(0, 0.95, -0.5); povGroup.add(bar);

  const gripL = new THREE.Mesh(new THREE.CylinderGeometry(0.028, 0.028, 0.15), matGrip);

  gripL.rotation.z = Math.PI / 2; gripL.position.set(0.32, 0.95, -0.5); povGroup.add(gripL);

  const gripR = new THREE.Mesh(new THREE.CylinderGeometry(0.028, 0.028, 0.15), matGrip);

  gripR.rotation.z = Math.PI / 2; gripR.position.set(-0.32, 0.95, -0.5); povGroup.add(gripR);

  const displayMat = new THREE.MeshBasicMaterial({ color: zonas.z1.hex });

  const display = new THREE.Mesh(new THREE.BoxGeometry(0.13, 0.09, 0.02), displayMat);

  display.position.set(0, 1.0, -0.48); display.rotation.x = -Math.PI / 6; povGroup.add(display);

  const roadMat = new THREE.MeshStandardMaterial({ color: 0x0a0a0e, roughness: 0.8 });

  const road = new THREE.Mesh(new THREE.PlaneGeometry(12, 250), roadMat);

  road.rotation.x = -Math.PI / 2; road.position.set(0, 0, -110); scene.add(road);

  Object.keys(zonas).forEach(k => {

    const z = zonas[k];

    const faixaMat = new THREE.MeshBasicMaterial({ color: z.hex });

    const faixa = new THREE.Mesh(new THREE.PlaneGeometry(0.35, 250), faixaMat);

    faixa.rotation.x = -Math.PI / 2;

    faixa.position.set(z.xPos, 0.005, -110);

    scene.add(faixa);

  });

  const trackLines = [];

  const lineMat = new THREE.MeshBasicMaterial({ color: 0xffffff });

  const divisorX = [-2.2, 0.0, 2.2];

  

  for (let i = 0; i < 25; i++) {

    divisorX.forEach(posX => {

      const line = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.01, 2.5), lineMat);

      line.position.set(posX, 0.01, -i * 10); 

      scene.add(line); 

      trackLines.push(line);

    });

  }

  const botoesTempo = document.querySelectorAll('.botao-tempo');

  const painelControle = document.getElementById('painelControle');

  const indicadorFaixa = document.getElementById('indicadorFaixa');

  const tempoEl = document.getElementById('tempo');

  const btnIniciar = document.getElementById('btnIniciar');

  const btnParar = document.getElementById('btnParar');

  const btnReiniciar = document.getElementById('btnReiniciar');

  const btnTela = document.getElementById('btnTela');

  const barra = document.getElementById('barra');

  const subProgressoEtapa = document.getElementById('subProgressoEtapa');

  const elCal = document.getElementById('cal');

  const elKm = document.getElementById('km');

  const elVel = document.getElementById('vel');

  const elRpm = document.getElementById('rpm');

  const fpsCounter = document.getElementById('fpsCounter');

  const setaEsqBox = document.getElementById('setaEsqBox');

  const setaDirBox = document.getElementById('setaDirBox');

  const setaEsqIcone = document.getElementById('setaEsqIcone');

  const setaDirIcone = document.getElementById('setaDirIcone');

  const setaEsqStatus = document.getElementById('setaEsqStatus');

  const setaDirStatus = document.getElementById('setaDirStatus');

  let tempoTotal = 0, tempoRestante = 0;

  let cronometro = null, treinoAtivo = false;

  let calorias = 0, distancia = 0;

  

  let indiceEtapaHIIT = 0;

  let tempoSegundosEtapa = 0;

  let zonaChaveAtual = 'z1';

  let xAlvoCamera = zonas.z1.xPos;

  botoesTempo.forEach(btn => {

    btn.addEventListener('click', () => {

      botoesTempo.forEach(b => b.classList.remove('selecionado'));

      btn.classList.add('selecionado');

      tempoTotal = parseInt(btn.dataset.segundos);

      tempoRestante = tempoTotal;

      atualizaTela();

      btnIniciar.disabled = false;

    });

  });

  function atualizarBlocosEspectro(zonaAtiva) {

    ['z1', 'z2', 'z3', 'z4'].forEach(z => {

      const el = document.getElementById('b' + z);

      if (z === zonaAtiva) el.classList.add('ativo');

      else el.classList.remove('ativo');

    });

  }

  function aplicarEtapaHIIT(etapaIndex) {

    const etapa = cicloHIIT[etapaIndex];

    zonaChaveAtual = etapa.zona;

    tempoSegundosEtapa = 0;

    

    const z = zonas[zonaChaveAtual];

    xAlvoCamera = z.xPos;

    painelControle.style.borderColor = z.cor;

    tempoEl.style.color = z.cor;

    barra.style.backgroundColor = z.cor;

    indicadorFaixa.textContent = z.nome;

    indicadorFaixa.style.color = z.cor;

    document.querySelectorAll('.dado-card span').forEach(el => el.style.color = z.cor);

    displayMat.color.set(z.hex);

    atualizarBlocosEspectro(zonaChaveAtual);

    falarTreinador(etapa.fala);

  }

  function formatarTempo(s) {

    const h = Math.floor(s / 3600).toString().padStart(2, '0');

    const m = Math.floor((s % 3600) / 60).toString().padStart(2, '0');

    const seg = (s % 60).toString().padStart(2, '0');

    return `${h}:${m}:${seg}`;

  }

  function atualizaTela() {

    const z = zonas[zonaChaveAtual];

    tempoEl.textContent = formatarTempo(tempoRestante);

    barra.style.width = `${tempoTotal > 0 ? ((tempoTotal - tempoRestante) / tempoTotal) * 100 : 0}%`;

    

    const etapaAtual = cicloHIIT[indiceEtapaHIIT];

    const restanteEtapa = etapaAtual.duracao - tempoSegundosEtapa;

    subProgressoEtapa.textContent = `Etapa (${etapaAtual.zona.toUpperCase()}): ${restanteEtapa}s`;

    elCal.textContent = calorias.toFixed(1);

    elKm.textContent = distancia.toFixed(2);

    elVel.textContent = z.vel.toFixed(1);

  }

  btnIniciar.addEventListener('click', () => {

    if(tempoRestante <= 0) return;

    treinoAtivo = true;

    if(cronometro) clearInterval(cronometro);

    

    aplicarEtapaHIIT(indiceEtapaHIIT);

    cronometro = setInterval(() => {

      tempoRestante--;

      tempoSegundosEtapa++;

      const etapaAtual = cicloHIIT[indiceEtapaHIIT];

      if (tempoSegundosEtapa >= etapaAtual.duracao && tempoRestante > 0) {

        indiceEtapaHIIT = (indiceEtapaHIIT + 1) % cicloHIIT.length;

        aplicarEtapaHIIT(indiceEtapaHIIT);

      }

      const z = zonas[zonaChaveAtual];

      calorias += (18 * (z.vel / 15)) / 60;

      distancia += z.vel / 3600;

      elRpm.textContent = Math.round(z.rpm + Math.sin(tempoRestante / 2) * 4);

      atualizaTela();

      if (tempoRestante <= 0) {

        clearInterval(cronometro);

        treinoAtivo = false;

        falarTreinador("Treino concluido com sucesso! Excelente desempenho!");

        btnIniciar.disabled = btnParar.disabled = true;

      }

    }, 1000);

    

    btnIniciar.disabled = true;

    btnParar.disabled = false;

    btnReiniciar.disabled = false;

  });

  btnParar.addEventListener('click', () => {

    if (treinoAtivo) {

      clearInterval(cronometro);

      treinoAtivo = false;

      btnParar.textContent = "Continuar";

      falarTreinador("Treino pausado.");

    } else {

      btnIniciar.click();

      btnParar.textContent = "Pausar";

    }

  });

  btnReiniciar.addEventListener('click', () => {

    clearInterval(cronometro);

    tempoRestante = tempoTotal;

    indiceEtapaHIIT = 0;

    tempoSegundosEtapa = 0;

    calorias = 0; distancia = 0;

    treinoAtivo = false;

    aplicarEtapaHIIT(0);

    atualizaTela();

    falarTreinador("Treino reiniciado!");

    btnIniciar.disabled = false;

    btnParar.disabled = true;

    btnReiniciar.disabled = true;

    btnParar.textContent = "Pausar";

  });

  btnTela.addEventListener('click', () => {

    if (!document.fullscreenElement) document.documentElement.requestFullscreen();

    else document.exitFullscreen();

  });

  let step = 0;

  let lastTime = performance.now();

  let frameCount = 0;

  function animate(currentTime) {

    requestAnimationFrame(animate);

    frameCount++;

    if (currentTime - lastTime >= 1000) {

      fpsCounter.textContent = `${frameCount} FPS`;

      frameCount = 0;

      lastTime = currentTime;

    }

    camera.position.x += (xAlvoCamera - camera.position.x) * 0.12;

    povGroup.position.x = camera.position.x;

    if (treinoAtivo) {

      const z = zonas[zonaChaveAtual];

      step += 0.07 * (z.rpm / 60);

      const speed = z.vel / 60;

      trackLines.forEach(line => {

        line.position.z += speed;

        if (line.position.z > 5) line.position.z = -245;

      });

      camera.position.y = 1.25 + Math.sin(step * 2) * 0.015;

      povGroup.position.y = Math.sin(step * 2) * 0.008;

      povGroup.rotation.z = Math.sin(step) * 0.05;

      povGroup.rotation.y = Math.cos(step) * 0.02;

      const alternanciaPedal = Math.sin(step);

      if (alternanciaPedal > 0) {

        setaEsqBox.className = "painel-seta esquerda ativo-cima";

        setaEsqIcone.textContent = "▲";

        setaEsqStatus.textContent = "CIMA";

        setaDirBox.className = "painel-seta direita ativo-baixo";

        setaDirIcone.textContent = "▼";

        setaDirStatus.textContent = "BAIXO";

      } else {

        setaEsqBox.className = "painel-seta esquerda ativo-baixo";

        setaEsqIcone.textContent = "▼";

        setaEsqStatus.textContent = "BAIXO";

        setaDirBox.className = "painel-seta direita ativo-cima";

        setaDirIcone.textContent = "▲";

        setaDirStatus.textContent = "CIMA";

      }

    } else {

      povGroup.rotation.z *= 0.92;

      povGroup.rotation.y *= 0.92;

    }

    renderer.render(scene, camera);

  }

  window.addEventListener('resize', () => {

    camera.aspect = container.clientWidth / container.clientHeight;

    camera.updateProjectionMatrix();

    renderer.setSize(container.clientWidth, container.clientHeight);

  });

  // Inicializar

  carregarSequenciasSalvas();

  atualizarInfoSequenciaAtual();

  requestAnimationFrame(animate);

})();

</script>

</html>
